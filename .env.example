# MongoDB Atlas connection string
# Format: mongodb+srv://USER:PASSWORD@HOST/DBNAME?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/shebuilds?retryWrites=true&w=majority

# Long random string used to sign Payload sessions
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Production: set the same keys in your host (Vercel → Settings → Environment Variables).
# Do not commit real .env values.
